# Supabase → Project Settings → General (URL) and → API Keys (tab "Publishable and secret API keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional. Login uses window.location.origin for magic-link redirects.
# Still add every deploy URL under Supabase → Authentication → URL Configuration → Redirect URLs
# (e.g. http://localhost:3000/** and https://fundeando.vercel.app/**).
# NEXT_PUBLIC_SITE_URL=https://fundeando.vercel.app

# SPIDI backend. Sandbox is a live backend, not a simulator — it can still move money.
SPIDI_API_URL=https://sandbox.api.spidipagos.com/api/spidipagos
# Production:
# SPIDI_API_URL=https://api.spidipagos.com/api/spidipagos
