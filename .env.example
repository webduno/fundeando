# Supabase → Project Settings → General (URL) and → API Keys (tab "Publishable and secret API keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Where magic links send the user back. Must be in Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SPIDI backend. Sandbox is a live backend, not a simulator — it can still move money.
SPIDI_API_URL=https://sandbox.api.spidipagos.com/api/spidipagos
# Production:
# SPIDI_API_URL=https://api.spidipagos.com/api/spidipagos
